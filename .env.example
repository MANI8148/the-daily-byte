# Copy to .env and fill in. Worker + deploy + render all read this.

# --- LLM (any OpenAI-compatible /chat/completions endpoint) ---
# FREE options (recommended — OpenAI itself is the only paid one here):
#   Groq       OPENAI_BASE_URL=https://api.groq.com/openai/v1        model=llama-3.3-70b-versatile   (fast, free tier)
#   Gemini     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  model=gemini-2.0-flash  (AI Studio free key)
#   OpenRouter OPENAI_BASE_URL=https://openrouter.ai/api/v1          model=meta-llama/llama-3.3-70b-instruct:free (free models, less stable)
#   Nous       OPENAI_BASE_URL=http://localhost:4000/v1              (your local proxy)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_...
OPENAI_MODEL=llama-3.3-70b-versatile

# Curation uses a cheap model; drafting uses OPENAI_MODEL. Same endpoint, different model names.
LLM_SCORE_MODEL=llama-3.1-8b-instant
LLM_SCORE_THRESHOLD=6

# --- LLM fallbacks (optional; tried in order on 429/401/5xx/network failures) ---
# JSON list: [{"base_url": "...", "api_key": "...", "model": "..."}] — model optional (uses OPENAI_MODEL)
LLM_FALLBACKS=[]

# --- OpenCode CLI fallback (4th LLM tier; own account quota) ---
OPENCODE_API_KEY=
OPENCODE_MODEL=

# --- Supabase (the database, free tier) ---
SUPABASE_URL=https://atbyvsaukqrasvqulldj.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Front end (Vite public env; anon key is PUBLIC by design — RLS limits it to
#     INSERT-only on `suggestions`. Set these in Vercel env + .env.local too.) ---
VITE_SUPABASE_URL=https://atbyvsaukqrasvqulldj.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Git review loop: drafts -> content/drafts/<slug>.md -> PR -> merge -> Vercel ---
GITHUB_TOKEN=ghp_...            # fine-grained token, Contents+PRs on the blog repo
GIT_REPO=MANI8148/bloggy        # "owner/repo"
GIT_BRANCH=main

# --- Cross-posting keys (all optional; free tiers; adapter skips when unset) ---
DEVTO_API_KEY=
MEDIUM_TOKEN=
HASHNODE_TOKEN=
HASHNODE_PUBLICATION=
GHOST_ADMIN_KEY=                # <id>:<secret>
GHOST_URL=
BUTTONDOWN_API_KEY=             # newsletter draft (free tier, real API)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=           # Settings -> App Passwords
# X/Twitter: free tier exists (500 posts/mo) but needs developer-portal approval — enable later.

# --- Telegram notify (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site identity (canonical URLs + static site build) ---
SITE_NAME=The Daily Byte
SITE_TAGLINE=Student Tech Edition
SITE_URL=https://bloggy.vercel.app
AUTHOR_NAME=Manikanta

# --- Pipeline behaviour ---
TOPICS=ai,ml,llm,opensource,github,python
DEFAULT_TAGS=ai,ml,tech
AUTO_PUBLISH=false              # PR review gate stays ON until you trust the checks
APPROVE_TOKEN=changeme
DAEMON_INTERVAL_MIN=360