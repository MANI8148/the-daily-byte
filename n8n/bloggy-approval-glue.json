{
  "name": "Bloggy — approval & notify glue (optional)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bloggy/draft",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Draft webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "bloggy-draft"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  title: b.title || 'untitled',\n  approve: b.approveUrl || '',\n  status: b.status || 'draft',\n  msg: `📝 Draft ready: ${b.title || ''}\\n${b.approveUrl || ''}\\nChecks: ${JSON.stringify(b.checks || {})}`\n} }];"
      },
      "id": "code-1",
      "name": "Format message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_CHAT_ID}}",
        "text": "={{ $json.msg }}",
        "additionalFields": {}
      },
      "id": "tg-1",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Draft webhook": { "main": [[{ "node": "Format message", "type": "main", "index": 0 }]] },
    "Format message": { "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}